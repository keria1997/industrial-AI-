# 工业AI平台 Ubuntu 生产环境配置模板
# 用法：复制为 .env 后修改所有 change-me 项，再执行 deploy.sh
#
# 安全要求：
#   - AUTH_SECRET、FULFILLMENT_DATA_KEY、DATABASE_PASSWORD 必须使用强随机值
#   - 生产环境 DEMO_AUTH_ENABLED 必须为 false
#   - 文件权限应为 600，所有者为 industrial-ai 用户

# ========== 后端 API ==========
# 监听地址：nginx 同机部署时保持 127.0.0.1；多机部署改为 0.0.0.0 并配合防火墙
PRODUCTION_API_HOST=127.0.0.1
PRODUCTION_API_PORT=5185

# 会话签名密钥，必填。生成：openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret

# Java-native runtime. Both values are defaults in Java; retain them explicitly
# so an operator cannot accidentally reintroduce proxy behavior.
JAVA_NATIVE_ONLY=true
LEGACY_PROXY_ENABLED=false

# 演示登录，生产环境必须关闭
DEMO_AUTH_ENABLED=false
DEMO_AUTH_ACCOUNT=admin,reviewer,operator,inspector
DEMO_AUTH_PASSWORD=change-me

# ========== 数据库 ==========
DATABASE_URL=jdbc:postgresql://industrial_ai:change-me@127.0.0.1:5432/industrial_ai
PRODUCTION_DB_POOL_SIZE=20
FULFILLMENT_DB_POOL_SIZE=20
MODULE_DB_POOL_SIZE=10

# ========== 履约数据加密 ==========
# 主密钥 ID（用于密钥轮换识别）
FULFILLMENT_DATA_KEY_ID=prod-v1
# 主密钥，base64 编码的 32 字节。生成：openssl rand -base64 32
FULFILLMENT_DATA_KEY=change-me-to-a-base64-encoded-32-byte-key

# ========== Outbox Worker ==========
# Worker 运行在 Java 主进程内，按待处理事件动态发现租户
# Worker 按待处理事件动态发现租户（依赖 018 迁移的 infra 只读策略）

# ========== 前端构建产物 ==========
# 部署后由 nginx 直接服务 dist/，无需后端代理前端
