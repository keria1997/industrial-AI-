# Industrial AI Platform - Ubuntu production environment template.
# Copy to .env in the extracted release and replace every change-me value.

# Backend API.
# Keep the API on loopback when Nginx runs on the same host.
PRODUCTION_API_HOST=127.0.0.1
PRODUCTION_API_PORT=5185

# Session signing secret: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret

# Java-native persistence is required for production.
JAVA_NATIVE_ONLY=true
LEGACY_PROXY_ENABLED=false

# Never enable demo login in production.
DEMO_AUTH_ENABLED=false
DEMO_AUTH_ACCOUNT=
DEMO_AUTH_PASSWORD=change-me

# Database. create-database.sh derives role, password, and database name.
DATABASE_URL=jdbc:postgresql://industrial_ai:change-me@127.0.0.1:5432/industrial_ai
PRODUCTION_DB_POOL_SIZE=20
FULFILLMENT_DB_POOL_SIZE=20
MODULE_DB_POOL_SIZE=10

# Fulfillment encryption. The key must decode to exactly 32 bytes:
# openssl rand -base64 32
FULFILLMENT_DATA_KEY_ID=prod-v1
FULFILLMENT_DATA_KEY=change-me-to-a-base64-encoded-32-byte-key

# Background outbox workers run inside the Java process.
PERSONNEL_WORKER_ENABLED=true
MESSAGE_WORKER_ENABLED=true
FINANCE_WORKER_ENABLED=true
SUPPLY_CHAIN_WORKER_ENABLED=true
PRODUCTION_WORKER_ENABLED=true
FULFILLMENT_WORKER_ENABLED=true
AI_WORKER_ENABLED=true
PERSONNEL_WORKER_INTERVAL_MS=2000
MESSAGE_WORKER_INTERVAL_MS=2000
FINANCE_WORKER_INTERVAL_MS=2000
SUPPLY_CHAIN_WORKER_INTERVAL_MS=2000
PRODUCTION_WORKER_INTERVAL_MS=2000
FULFILLMENT_WORKER_INTERVAL_MS=2000
AI_WORKER_INTERVAL_MS=2000
