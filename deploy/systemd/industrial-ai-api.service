[Unit]
Description=Industrial AI Platform - Java Production API
Documentation=https://github.com/your-org/gongye_ai_plat
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=industrial-ai
Group=industrial-ai
WorkingDirectory=/opt/industrial-ai/current/app
EnvironmentFile=/opt/industrial-ai/current/.env

ExecStart=/usr/bin/java -XX:MaxRAMPercentage=75 -jar /opt/industrial-ai/current/app/server-java/industrial-ai-api-0.1.0.jar

# 优雅关闭：先 SIGTERM，等待 30s 后 SIGKILL
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# 标准输出 / 错误均写入日志
StandardOutput=append:/opt/industrial-ai/logs/api.log
StandardError=append:/opt/industrial-ai/logs/api.err.log

# 资源限制
LimitNOFILE=65535
MemoryMax=2G

# 安全沙箱
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/industrial-ai/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
