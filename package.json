{
  "name": "ai-nexus-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "tsx server/src/index.ts",
    "db:migrate:production": "tsx server/src/migrate.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test:api": "vitest run server/test",
    "test:frontend": "vitest run src/app/tests",
    "test": "npm run test:api && npm run test:frontend"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "fastify": "^5.10.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "vitest": "^3.2.7"
  }
}
