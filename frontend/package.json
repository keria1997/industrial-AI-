{
  "name": "ai-nexus-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:java-api": "node scripts/dev-java-api.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:routes:java": "node scripts/verify-java-routes.mjs",
    "test:frontend": "vitest run src/app/tests src/shared/*.test.ts",
    "test:prototype-storage": "node tests/prototypeStorage.e2e.mjs",
    "test:java": "mvn -f server-java/pom.xml -o test",
    "test": "npm run test:routes:java && npm run test:frontend && npm run test:java"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.64.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.3.5",
    "vitest": "4.1.11"
  }
}
